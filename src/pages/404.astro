---
import Layout from '../layouts/Layout.astro';
import { resolvePath } from '../utils/paths.js';
---

<Layout title="404 - Record Not Found | Fictional History Archive">
  <div class="border-4 border-archive-border bg-archive-surface p-8 max-w-2xl mx-auto text-center my-16">
    <div class="mb-6 inline-block p-4 border-2 border-archive-accent text-archive-accent">
      <svg class="w-16 h-16 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
      <span class="font-sans text-xl uppercase tracking-widest font-bold">Error 404</span>
    </div>
    <h1 class="font-display text-4xl mb-4 text-archive-paper">Archive Record Not Found</h1>
    <p class="font-serif text-archive-muted mb-8 leading-relaxed">
      The historical document you are attempting to access has either been redacted by temporal authorities, lost to a timeline collapse, or never existed in this iteration of the multiverse.
    </p>
    <a href={resolvePath('/')} class="inline-block bg-archive-border hover:bg-archive-accent hover:text-archive-bg transition-colors font-sans text-sm uppercase tracking-widest px-6 py-3 border border-archive-accent text-archive-paper">
      Return to Main Directory
    </a>
  </div>
</Layout>
