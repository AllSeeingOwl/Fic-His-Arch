---
import Layout from '../layouts/Layout.astro';
import DirectoryView from '../components/DirectoryView.jsx';
import { getCollection } from 'astro:content';
import { resolvePath } from '../utils/paths.js';

// Retrieve all articles from the 'archive' collection
const allArchiveEntries = await getCollection('archive');

// Map to simplified objects to pass to the React component
const articles = allArchiveEntries.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  in_universe_date: entry.data.in_universe_date,
  location: entry.data.dateline_location,
  source_work: entry.data.source_work,
  context_note: entry.data.context_note,
  url: resolvePath(`/archive/${entry.id}`), // Assuming basic route structure based on index.astro
}));
---

<Layout title="FHA - Directory & Timeline">
  <div class="mb-10 border-b-2 border-archive-border pb-6">
    <h2 class="font-display text-4xl text-archive-paper mb-2 tracking-tight">
      Master Directory
    </h2>
    <p class="font-serif text-lg text-archive-muted leading-relaxed max-w-3xl">
      A comprehensive index of all chronological anomalies documented within the archive.
      Use the controls below to alternate between the master list table and the chronological timeline view.
    </p>
  </div>

  <noscript>
    <div class="mb-6 p-4 bg-archive-surface border-l-4 border-archive-accent text-archive-paper font-sans text-sm">
      <p>System Note: JavaScript is required for interactive timeline toggling. Defaulting to Master List view.</p>
    </div>
  </noscript>

  {/* ⚡ Bolt: Use client:idle instead of client:load to defer hydration of this heavy component until the main thread is free, improving initial page load performance and TTI. */}
  <DirectoryView articles={articles} client:idle />
</Layout>
