---
import Layout from '../../layouts/Layout.astro';
import CitationBlock from '../../components/CitationBlock.jsx';
import ArchiveInteractiveSection from '../../components/ArchiveInteractiveSection.jsx';
import { getCollection, render } from 'astro:content';
import { getFlairColors } from '../../utils/flairColors.js';

export async function getStaticPaths() {
  const archiveEntries = await getCollection('archive');
  return archiveEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const citationData = {
  title: data.title,
  work: data.source_work,
  medium: data.source_medium,
  creator: data.source_creator,
  release_year: data.release_year,
  note: data.context_note,
  external_links: data.external_links,
};

// ⚡ Bolt: Cache flair colors to avoid calling getFlairColors multiple times
const flairColors = getFlairColors(data.timeline_flair);
---

<Layout title={data.title}>
  <article class="prose prose-invert prose-archive max-w-none">
    <header class="mb-8">
      <h1 class="font-display text-4xl mb-2">{data.title}</h1>
      <div class="flex flex-wrap items-center gap-4 text-sm font-sans text-archive-muted border-b border-archive-border pb-4">
        <span>CLASSIFIED // EYES ONLY</span>
        <span class="text-archive-accent">
          {data.timelineVariants && data.timelineVariants.length > 0
            ? 'TIMELINE VARIANCE DETECTED'
            : 'TIMELINE INTEGRITY CONFIRMED'}
        </span>
        <span class={`px-2 py-0.5 rounded border flex items-center gap-1.5 text-[10px] font-semibold uppercase ${flairColors.border} ${flairColors.text} ${flairColors.bg}`}>
          <span class={`w-1.5 h-1.5 rounded-full ${flairColors.dot}`}></span>
          {data.timeline_flair}
        </span>
        {data.adaptation_type && data.adaptation_type !== 'Original' && (
          <span class="text-archive-accent font-semibold uppercase">
            {data.adaptation_type} // {data.adaptation_fidelity}
          </span>
        )}

        <span class="ml-auto flex gap-4">
            <span>LOC: {data.dateline_location}</span>
            <span>DATE: {data.in_universe_date}</span>
        </span>
      </div>
    </header>

    {data.has_spoilers && (
      <div id="spoiler-banner" class="bg-archive-surface border-l-4 border-archive-accent p-4 mb-8 flex flex-col sm:flex-row justify-between items-center gap-4">
        <div class="text-sm">
          <strong class="text-archive-accent uppercase tracking-widest block mb-1">Warning: Classified Material</strong>
          <span class="text-archive-muted">This document contains heavily redacted major plot points. Reveal at your own discretion.</span>
        </div>
        <div class="flex gap-2 shrink-0">
          <button id="reveal-all-btn" class="px-4 py-2 bg-archive-accent text-archive-bg text-xs font-bold uppercase tracking-widest rounded hover:bg-opacity-90 transition-opacity">
            Reveal All
          </button>
          <button id="keep-redacted-btn" class="px-4 py-2 border border-archive-border text-archive-muted text-xs font-bold uppercase tracking-widest rounded hover:text-archive-paper hover:border-archive-paper transition-colors">
            Keep Redacted
          </button>
        </div>
      </div>
    )}

    <div class="font-serif leading-relaxed text-archive-paper mb-8" id="article-content">
      <Content />
    </div>

    {data.timelineVariants && data.timelineVariants.length > 0 ? (
      // ⚡ Bolt: Use client:visible to lazy-load the interactive section only when it enters the viewport, reducing initial JS payload
      <ArchiveInteractiveSection
        variants={data.timelineVariants}
        defaultCitation={citationData}
        client:visible
      />
    ) : (
      <CitationBlock source={citationData} />
    )}
  </article>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const contentDiv = document.getElementById('article-content');
    if (!contentDiv) return;

    // 1. Process inline redactions
    // We look for ||something|| and replace it with a styled span
    // 🛡️ Sentinel: Sanitize text nodes before rendering them to avoid DOM-based XSS
    const escapeHTML = (str) => str.replace(/[&<>'"]/g, tag => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      "'": '&#39;',
      '"': '&quot;'
    }[tag] || tag));
    // ⚡ Bolt: Hoist RegExp to avoid re-compiling it on every single DOM node visited
    const regex = /\|\|(.*?)\|\|/g;

    const walkDOM = (node) => {
      if (node.nodeType === 3) { // Text node
        const text = node.nodeValue;
        // ⚡ Bolt: Add fast-path check to avoid running regex tests/replacements when not needed
        if (text.includes('||') && regex.test(text)) {
          const span = document.createElement('span');
          const escapedText = escapeHTML(text);
          span.innerHTML = escapedText.replace(regex, '<span class="redacted-spoiler focus:outline-none focus-visible:ring-2 focus-visible:ring-archive-accent rounded" title="Click to reveal" role="button" tabindex="0">$1</span>');
          node.parentNode.replaceChild(span, node);
        }
      } else if (node.nodeType === 1 && node.nodeName !== 'SCRIPT' && node.nodeName !== 'STYLE') {
        // Element node
        Array.from(node.childNodes).forEach(walkDOM);
      }
    };

    walkDOM(contentDiv);

    // 2. Add click handlers to individual redactions
    const spoilers = document.querySelectorAll('.redacted-spoiler');
    spoilers.forEach(spoiler => {
      const toggleReveal = () => spoiler.classList.toggle('revealed');
      spoiler.addEventListener('click', toggleReveal);
      spoiler.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleReveal();
        }
      });
    });

    // 3. Handle banner buttons
    const banner = document.getElementById('spoiler-banner');
    const revealAllBtn = document.getElementById('reveal-all-btn');
    const keepRedactedBtn = document.getElementById('keep-redacted-btn');

    if (revealAllBtn && keepRedactedBtn && banner) {
      revealAllBtn.addEventListener('click', () => {
        spoilers.forEach(s => s.classList.add('revealed'));
        banner.style.display = 'none';
      });

      keepRedactedBtn.addEventListener('click', () => {
        spoilers.forEach(s => s.classList.remove('revealed'));
        banner.style.display = 'none';
      });
    }
  });
</script>

</Layout>
