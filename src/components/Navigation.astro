---
import { resolvePath } from '../utils/paths.js';

const currentPath = Astro.url.pathname;

const isLinkActive = (href) => {
  const resolvedHref = resolvePath(href);
  // Add a trailing slash for consistent comparison
  const normalizedCurrent = currentPath.endsWith('/') ? currentPath : currentPath + '/';
  const normalizedHref = resolvedHref.endsWith('/') ? resolvedHref : resolvedHref + '/';

  // Strict matching for home
  if (normalizedHref === resolvePath('/') || normalizedHref === resolvePath('/') + '/') {
    return normalizedCurrent === normalizedHref;
  }
  // Prefix matching for other routes
  return normalizedCurrent.startsWith(normalizedHref);
};

const links = [
  { name: 'Home', href: '/' },
  { name: 'Directory', href: '/directory' },
  { name: 'Timeline', href: '/timeline' },
  { name: 'Sightings', href: '/time-travelers' },
  { name: 'Media', href: '/browse' },
  { name: 'About', href: '/about' },
  { name: 'Handbook', href: '/handbook' },
  { name: 'Contribute', href: '/contribute' },
  { name: 'Contact', href: '/contact' },
];
---

<nav class="relative z-50">
  {/* Hamburger Button */}
  <button
    id="hamburger-btn"
    class="block text-archive-paper focus:outline-none focus-visible:ring-2 focus-visible:ring-archive-accent focus-visible:ring-offset-2 focus-visible:ring-offset-archive-surface rounded p-2 -mr-2 hover:text-archive-accent transition-colors"
    aria-label="Open menu"
    aria-expanded="false"
  >
    <svg id="hamburger-icon-open" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
    </svg>
    <svg id="hamburger-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>

  {/* Menu Dropdown */}
  <div id="mobile-menu" class="hidden absolute top-full right-0 mt-6 w-48 bg-archive-surface border-2 border-archive-border shadow-lg z-50">
    <ul class="flex flex-col p-2 space-y-1">
      {links.map((link) => {
        const active = isLinkActive(link.href);
        return (
          <li>
            <a
              href={resolvePath(link.href)}
              aria-current={active ? "page" : undefined}
              class={`block px-4 py-2 font-sans text-sm uppercase tracking-widest transition-colors rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-archive-accent focus-visible:ring-inset ${
                active
                  ? 'bg-archive-bg/50 text-archive-accent font-bold border-l-2 border-archive-accent -ml-[2px]'
                  : 'text-archive-muted hover:bg-archive-bg hover:text-archive-accent border-l-2 border-transparent -ml-[2px]'
              }`}
            >
              {link.name}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</nav>

<script>
  const btn = document.getElementById('hamburger-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('hamburger-icon-open');
  const iconClose = document.getElementById('hamburger-icon-close');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      btn.setAttribute('aria-label', isExpanded ? 'Open menu' : 'Close menu');

      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconOpen.classList.toggle('block');
      iconClose.classList.toggle('hidden');
      iconClose.classList.toggle('block');
    });
  }
</script>
