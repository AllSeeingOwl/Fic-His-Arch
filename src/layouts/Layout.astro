---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Fictional History Archive" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-archive-bg text-archive-paper font-serif min-h-screen">
    <header class="bg-archive-surface mb-8">
      <div class="py-6 px-8 border-b border-dashed border-archive-border">
        <div class="max-w-4xl mx-auto flex items-start justify-between gap-4">
          <div>
            <h1 class="font-display text-3xl sm:text-4xl text-archive-paper tracking-tight mb-1">
              Fictional History <span class="text-archive-accent">Archive</span>
            </h1>
            <p class="font-sans text-[10px] sm:text-xs uppercase tracking-widest text-archive-muted">
              Preserving the chronological anomalies of the multiverse
            </p>
          </div>
          <div class="hidden sm:block text-right whitespace-nowrap">
            <p class="font-sans text-[10px] text-archive-terminal uppercase">System_Status: Online</p>
            <p class="font-sans text-[10px] text-archive-terminal uppercase">Microfilm_Ready</p>
          </div>
          <div class="sm:hidden mt-1">
            <Navigation />
          </div>
        </div>
      </div>
      <div class="border-b-4 border-archive-border py-3 px-8 hidden sm:block">
        <div class="max-w-4xl mx-auto">
          <Navigation />
        </div>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-8 pb-16">
      <slot />
    </main>
  </body>
</html>
