{
  "name": "fic-his-arch",
  "version": "1.0.0",
  "type": "module",
  "description": "Fic-His-Arch website",
  "scripts": {
    "dev:server": "nodemon --exec ts-node server.ts",
    "test": "jest --passWithNoTests --testPathIgnorePatterns=\"e2e\"",
    "test:e2e:playwright": "playwright test",
    "test:e2e:cypress": "cypress open",
    "lint": "eslint . --ignore-pattern '.astro/'",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "build:astro": "astro build"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "knip": {
    "ignoreBinaries": [
      "wait-on"
    ],
    "ignore": [
      "public/msdos_typing_effect.js"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.2",
    "@types/supertest": "^7.2.0",
    "@types/yaml": "^1.9.7",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "axe-core": "^4.11.4",
    "csv-parse": "^7.0.0",
    "csv-stringify": "^6.8.0",
    "cypress": "^15.15.0",
    "eslint": "^10.4.0",
    "eslint-plugin-jest": "^29.15.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "knip": "^6.16.1",
    "lint-staged": "^17.0.5",
    "nodemon": "^3.1.14",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^6.4.4",
    "express": "^5.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cypress",
      "unrs-resolver"
    ]
  }
}
