{
  "name": "fic-his-arch",
  "version": "1.0.0",
  "type": "module",
  "description": "Fic-His-Arch website",
  "scripts": {
    "dev:server": "nodemon --exec ts-node server.ts",
    "test": "jest --passWithNoTests --testPathIgnorePatterns=\"e2e\"",
    "test:e2e:playwright": "playwright test",
    "test:e2e:cypress": "cypress open",
    "lint": "eslint . --ignore-pattern '.astro/'",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "build:astro": "astro build"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "knip": {
    "ignoreBinaries": [
      "wait-on"
    ],
    "ignore": [
      "public/msdos_typing_effect.js"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/csurf": "^1.11.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "@types/supertest": "^7.2.1",
    "@types/yaml": "^1.9.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "axe-core": "^4.13.0",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "cypress": "^16.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "knip": "^6.36.0",
    "lint-staged": "^17.5.1",
    "nodemon": "^3.1.14",
    "playwright": "^1.60.0",
    "prettier": "^3.9.7",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@upstash/redis": "^1.38.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.3.3",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cypress",
      "unrs-resolver"
    ]
  }
}
